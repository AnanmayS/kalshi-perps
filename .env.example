# Copy to .env:  cp .env.example .env   (.env is git-ignored — never commit it)

# Environment: "demo" (default, safe) or "prod"
KALSHI_ENV=demo

# API key ID from Kalshi's developer portal (demo portal first). Leave blank until generated.
KALSHI_API_KEY_ID=

# Path to the RSA private key PEM downloaded when creating the key. Keep it outside the repo.
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/demo-key.pem

# LIVE TRADING SAFETY SWITCH.
# Real orders are placed ONLY when this is exactly "true" AND KALSHI_ENV=prod.
# Any other value (or demo env) => paper trading only.
KALSHI_LIVE_TRADING=false

# Risk engine
RISK_MAX_NOTIONAL_PER_TRADE=500
RISK_DAILY_LOSS_LIMIT=100
